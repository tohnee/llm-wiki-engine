# ---- 必填 ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=   # 可选:第三方兼容 API 地址(如 https://api.xxx.com)

# ---- 基础设施(docker-compose 默认值已对齐,本地可不改) ----
PG_DSN=postgresql://llmwiki:llmwiki@localhost:5432/llmwiki
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=llmwiki

# ---- 安全密钥(生产务必改) ----
INTERNAL_HMAC_SECRET=change-me-in-prod
JWT_SECRET=change-me-in-prod

# ---- 服务间地址 ----
EVIDENCE_URL=http://localhost:8001

# ---- 模型 ----
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-4-6

# ---- 可选:MinerU 解析服务(不设置则仅支持 .md/.txt 输入) ----
MINERU_URL=
