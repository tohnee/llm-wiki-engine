# =============================================================================
#  LLM-Wiki Engine — 环境变量模板(.env.template)
# -----------------------------------------------------------------------------
#  使用方式:
#    1. 复制本文件为 .env :        cp .env.template .env
#    2. 按你的真实 API/凭证填值
#    3. 生产部署前请阅读底部"生产强制清单"
#
#  与文档对应: LOCAL-DEPLOYMENT-GUIDE.md
#  与代码对应: llmwiki/app/core/config.py / security_guard.py / llm/embed.py
#
#  字段分组:
#    [A] 环境标记       [B] LLM Chat       [C] Embedding
#    [D] 基础设施 DSN   [E] 安全密钥       [F] 服务间地址
#    [G] 可选服务       [H] 调度 & 日志    [I] Mock 开关
#    [J] 前端构建变量
# =============================================================================


# ============================================================
# [A] 环境标记 — 影响 security_guard 是否阻断启动
# ============================================================
# 取值: dev / prod / production / staging
#   - dev(默认): 占位密钥/默认 DSN 只警告不阻断,便于本地开发
#   - prod/production/staging: 检测到弱配置直接 exit(78)
APP_ENV=dev


# ============================================================
# [B] LLM Chat 模型(必填,二选一)
# ============================================================
# Provider 切换: anthropic(完整功能) / openai(兼容模式)
#   - anthropic: 支持 Batch API + Prompt Caching + tool_use
#   - openai:    可接 DeepSeek / GLM / Qwen / vLLM / Ollama,但失去上述三特性
LLM_PROVIDER=openai

# ---- 方案 B1: OpenAI 兼容(国内/自部署 推荐)----
# 示例 base_url(任选其一):
#   DeepSeek          https://api.deepseek.com/v1
#   阿里百炼          https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM          https://open.bigmodel.cn/api/paas/v4
#   硅基流动          https://api.siliconflow.cn/v1
#   月之暗面 Kimi     https://api.moonshot.cn/v1
#   自部署 vLLM       http://your-host:8000/v1
OPENAI_API_KEY=sk-replace-with-your-openai-compatible-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ---- 方案 B2: Anthropic 原生(全功能,海外)----
# 留空表示使用 OpenAI 兼容模式;若启用 Anthropic 请设置 LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 可选第三方 Anthropic 兼容网关(留空走官方 api.anthropic.com)
ANTHROPIC_BASE_URL=

# ---- 模型分层(Haiku 高频小调用 / Sonnet 深度推理)----
# OpenAI 兼容模式示例:
MODEL_HAIKU=deepseek-chat
MODEL_SONNET=deepseek-reasoner
# Anthropic 原生模式示例(覆盖上面两行):
#MODEL_HAIKU=claude-haiku-4-5-20251001
#MODEL_SONNET=claude-sonnet-4-6

# 调用超时(秒) / 失败重试次数
LLM_TIMEOUT=180
LLM_RETRIES=2


# ============================================================
# [C] Embedding 模型(必填,1024 维强约束)
# ============================================================
# ⚠️ schema.sql 写死 vector(1024),换模型必须保证返回 1024 维。
# 已验证 1024 维 provider:
#   硅基流动        https://api.siliconflow.cn/v1    BAAI/bge-m3
#   阿里百炼        https://dashscope...compatible-mode/v1  text-embedding-v3
#   Cohere          https://api.cohere.ai/v1         embed-multilingual-v3.0
#   Jina            https://api.jina.ai/v1           jina-embeddings-v3
#   自部署 TEI/vLLM 你的内网地址                     BAAI/bge-m3
# ❌ OpenAI text-embedding-3-small 是 1536 维,不兼容
EMBED_API_KEY=sk-replace-with-your-embedding-key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3


# ============================================================
# [D] 基础设施 DSN(本地用 docker-compose 默认值即可)
# ============================================================
# Postgres 连接串。生产请改为独立账号 + 强密码,否则 security_guard 在 prod 模式拒绝启动
PG_DSN=postgresql://llmwiki:llmwiki@localhost:5432/llmwiki

# Redis(编译 Stream / session / schema 缓存)
REDIS_URL=redis://localhost:6379/0

# 对象存储(原文与快照,可选,D0/D1 不强依赖)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=llmwiki
# 如果用 MinIO,可继续填以下两个;生产换 AWS S3/阿里 OSS 的 IAM 凭证
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123


# ============================================================
# [E] 安全密钥(生产环境务必用强随机)
# ============================================================
# 生成命令(任选其一):
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 占位值会被 security_guard 在 prod 模式拒绝(EX_CONFIG / exit 78)
INTERNAL_HMAC_SECRET=change-me-in-prod-use-openssl-rand-hex-32
JWT_SECRET=change-me-in-prod-use-openssl-rand-hex-32
JWT_TTL_SEC=3600
PLATFORM_ADMIN_KEY=change-me-in-prod-use-openssl-rand-hex-32


# ============================================================
# [F] 服务间地址 — 同机 docker-compose 用默认即可
# ============================================================
# Evidence 服务(query/generation 调用它)
EVIDENCE_URL=http://localhost:8001
# Auth/Admin 服务(若前端经 admin 网关登录)
AUTH_API_URL=http://localhost:8002
# 入库服务(前端上传文档)
INGEST_API_URL=http://localhost:8003
# 生成服务(前端 generate 调用)
GENERATION_API_URL=http://localhost:8004
# 查询服务(前端 /ask 调用)
QUERY_API_URL=http://localhost:8000


# ============================================================
# [G] 可选:PDF 解析(MinerU)
# ============================================================
# 留空 → 仅支持 .md/.txt 入库;PDF 需先手动转 markdown
# 设置 → 编译期 L0 自动调用 MinerU 解析 PDF
MINERU_URL=
# MINERU_URL=http://localhost:8081

# 生成产物输出目录(generation 服务)
GENERATION_OUTPUT_DIR=/tmp/llmwiki-generated


# ============================================================
# [H] 调度 & 日志
# ============================================================
# on_schedule 调度器周期(秒);默认 86400 (每日)
SCHEDULE_INTERVAL_SEC=86400

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO


# ============================================================
# [I] Mock 开关(开发/CI/无 API 调试用)
# ============================================================
# LLM_MOCK=1 时跳过所有 LLM 调用,内置规则 mock 返回(抽取/路由/NLI/摘要/问答)
LLM_MOCK=0
# EMBED_MOCK=1 时返回零向量(BM25 仍工作,向量召回失效)
EMBED_MOCK=0


# ============================================================
# [J] 前端构建变量(写入 llmwiki/frontend/.env 或构建时传入)
# ============================================================
# 后端 API 网关地址(留空走 vite dev proxy / Nginx 反代)
VITE_API_BASE_URL=
# GitHub Pages 子路径部署(默认 "/")
VITE_BASE=/
# Demo 模式(1=纯前端预览,0=连真实后端)
VITE_DEMO_MODE=0


# =============================================================================
#  🔒 生产强制清单(APP_ENV=prod 时必查)
# -----------------------------------------------------------------------------
#  [ ] INTERNAL_HMAC_SECRET 已用 openssl rand -hex 32 生成,长度 ≥ 64 字符
#  [ ] JWT_SECRET           已用 openssl rand -hex 32 生成,长度 ≥ 64 字符
#  [ ] PLATFORM_ADMIN_KEY   已用 openssl rand -hex 32 生成,长度 ≥ 64 字符
#  [ ] PG_DSN 用了独立账号(非 llmwiki:llmwiki)+ 强密码
#  [ ] S3_ACCESS_KEY / S3_SECRET_KEY 换成真实 IAM(非 minio/minio123)
#  [ ] LLM_MOCK=0,EMBED_MOCK=0
#  [ ] LOG_LEVEL=INFO 或 WARNING(避免 DEBUG 在生产泄漏内部状态)
#  [ ] EMBED_MODEL 已验证返回 1024 维(否则向量检索失效)
# =============================================================================
